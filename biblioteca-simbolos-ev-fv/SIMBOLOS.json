  "integracacao_do_engine": {
    "localizacao": "frontend/src/utils/adapterDiagramaEV.js",
    "funcao_chave": "desenharComponente(tipo, propriedades)",
    "exemplo": {
      "disjuntor": {
        "svg": "1-disjuntor-simbolos.svg",
        "extrair_de_calculos": "calculos_nbr.disjuntor_a",
        "renderizar_como": "icon + label '63A'"
      },
      "idr": {
        "svg": "2-idr-simbolos.svg",
        "extrair_de_calculos": "calculos_nbr.dr_ma",
        "renderizar_como": "icon + label '30mA'"
      },
      "dps": {
        "svg": "3-dps-multiplo.svg",
        "extrair_de_calculos": "calculos_nbr.dps_kv + quantidade",
        "renderizar_como": "icon + label '0.28V' (múltiplos se necessário)"
      }
    }
  }
