PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# String de conexão do cluster oficial. Use a connection string SRV do Atlas.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/forte_solar
# Bypass do Atlas → grava em data/memory-storage.json. Deixe FALSE para persistência real.
# (true só para desenvolvimento offline; reseta concessionária p/ monofásico e some com INPE)
USE_MEMORY_STORAGE=false
# Opcional: sobrescreve os resolvers DNS antes de conectar. Necessário em máquinas onde o
# resolver do SO não resolve a busca SRV de mongodb+srv:// (erro `querySrv ECONNREFUSED`).
# No-op quando ausente. Ex.: 8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=

# Admin
ADMIN_API_KEY=dev-key-123

# ─── SMTP (Zoho Mail) — P0-AUTH-MAIL-01 ──────────────────────────────────────
# Transporte de e-mail para convite de novo usuário e redefinição de senha.
# SMTP_PASS é a SENHA DE APLICATIVO de 16 dígitos do Zoho (NUNCA a senha da conta).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=nao-responda@suaempresa.com.br
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=Forte Solar <nao-responda@suaempresa.com.br>
# Base do frontend usada nos links dos e-mails (ex.: https://app.fortesolar.com.br)
APP_URL=http://localhost:5173

# IA — Extração de Datasheets (obrigatório para upload de PDF e visão de imagens)
# Obtenha em: https://console.anthropic.com/api_keys
# Necessário para: Claude Vision, extração de garantias em imagens, selos, análise de equipamentos
# Você pode usar tanto em desenvolvimento quanto em produção (mesmo workspace)
ANTHROPIC_API_KEY=sk-ant-seu-valor-aqui

# SolarMarket Integration
SOLARMARKET_API_KEY=SUBSTITUA_PELA_SUA_CHAVE
SOLARMARKET_API_URL=https://api.solarmarket.com.br

# ── FV-INFRA-058 · origem pública e CORS ─────────────────────────────────────
# APP_URL é a FONTE ÚNICA da origem pública do frontend: dela nascem o link da
# proposta, o link de redefinição de senha e a allowlist de CORS.
# OBRIGATÓRIA em staging e produção — sem ela o processo NÃO sobe (fail-closed).
# FRONTEND_URL acima permanece só como alias legado.
#
# APP_AMBIENTE: development | staging | production (default: NODE_ENV).
APP_AMBIENTE=development
#
# CORS_ORIGENS: origens EXTRAS autorizadas, separadas por vírgula. Comparação é
# por origem exata — nunca substring. Deixe vazio se APP_URL basta.
CORS_ORIGENS=
#
# QA_URI_REMOTA_AUTORIZADA=sim libera scripts de QA a usarem uma URI remota cujo
# nome de banco não contenha staging/qa/homolog/teste. Use com intenção.
QA_URI_REMOTA_AUTORIZADA=
