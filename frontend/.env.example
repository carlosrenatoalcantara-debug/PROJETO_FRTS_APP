VITE_API_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── AE (Auditor de Equipamentos) ───────────────────────────────────────
# Base do Workbench do AE. Vazio = botao "Abrir AE" desabilitado.
# A Auditoria Rapida NAO usa esta variavel: ela chama o backend do Forte,
# que acessa o AE pelo provider configurado (AE_LIBRARY_DIR / AE_URL).
VITE_AE_URL=https://ae.fortesolar.com.br
# Opcional: template da URL do Workbench. Default: {VITE_AE_URL}/workbench
# VITE_AE_WORKBENCH_URL=https://ae.fortesolar.com.br/workbench
