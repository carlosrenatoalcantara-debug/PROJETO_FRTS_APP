# Ambiente de STAGING/QA — isolado da produção.
#
# FV-INFRA-058. O build só usa este arquivo com `--mode staging`
# (`npm run build:staging`). Um `npm run build` sem modo cai em
# `.env.production`, que aponta para a API REAL — foi o que a FV-QA-057 mediu.
#
# Preencha a URL da API de staging antes do primeiro deploy. O verificador
# `scripts/verificar-bundle.mjs` recusa o bundle se ele contiver a origem de
# produção ou se esta variável continuar com o placeholder.

VITE_API_URL=https://SUBSTITUA-API-STAGING.example.com/api
VITE_MODE=staging
VITE_ENABLE_ANALYTICS=false

# Chave PRÓPRIA de staging, com restrição de referrer para o domínio de staging.
# Nunca reaproveitar a chave de produção.
VITE_GOOGLE_MAPS_API_KEY=SUBSTITUA_CHAVE_STAGING
